---
// "/" no tiene contenido: manda a la persona a /es/, /en/ o /fr/
// según su elección manual; español por defecto.
// Es estático (sin servidor), por eso la redirección se hace en el navegador.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IcaTurismo</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://icaturismo.com/es/" />
    <noscript><meta http-equiv="refresh" content="0;url=/es/" /></noscript>
    <script is:inline>
      (function () {
        var supported = ['es', 'en', 'fr'];
        var lang = null;
        try { lang = localStorage.getItem('icat_lang_manual'); } catch (e) {}
        if (supported.indexOf(lang) === -1) lang = 'es';
        location.replace('/' + lang + '/' + location.hash);
      })();
    </script>
  </head>
  <body>
    <p><a href="/es/">Español</a> · <a href="/en/">English</a> · <a href="/fr/">Français</a></p>
  </body>
</html>
